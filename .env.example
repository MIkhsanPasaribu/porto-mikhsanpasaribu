# ============================================================
# DATABASE — Neon PostgreSQL
# Buat project di https://neon.tech, ambil connection string (pooled)
# ============================================================
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ============================================================
# AUTH — NextAuth.js v5
# Generate AUTH_SECRET: openssl rand -base64 32
# ============================================================
AUTH_SECRET="your-random-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ============================================================
# ADMIN CREDENTIALS
# ADMIN_PASSWORD_HASH: generate dengan script bcrypt
# Jalankan: node -e "const b=require('bcryptjs');console.log(b.hashSync('passwordmu',12))"
# ============================================================
ADMIN_EMAIL="mikhsanpasaribu@gmail.com"
ADMIN_PASSWORD_HASH="$2b$12$..."
